#!/usr/bin/env bash
set -euo pipefail

TOOL_ROOT="$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SOURCE_FILE="$TOOL_ROOT/config/source"
BUN_FILE="$TOOL_ROOT/config/bun"

if [[ -n "${WHALE_CAL_ROOT:-}" ]]; then
  ROOT="$WHALE_CAL_ROOT"
elif [[ -r "$SOURCE_FILE" ]]; then
  IFS= read -r ROOT < "$SOURCE_FILE"
else
  echo "cald-supervisor: Whale Cal source path is not configured; reinstall the Exocortex integration" >&2
  exit 1
fi

if [[ -n "${BUN_BIN:-}" ]]; then
  BUN="$BUN_BIN"
elif [[ -r "$BUN_FILE" ]]; then
  IFS= read -r BUN < "$BUN_FILE"
else
  BUN="$(command -v bun || true)"
fi

if [[ ! -f "$ROOT/scripts/supervise-daemon.ts" ]]; then
  echo "cald-supervisor: Whale Cal source checkout not found at $ROOT" >&2
  exit 1
fi
if [[ -z "$BUN" || ! -x "$BUN" ]]; then
  echo "cald-supervisor: Bun is not installed or executable" >&2
  exit 1
fi

exec "$BUN" run "$ROOT/scripts/supervise-daemon.ts"
